# Unitwin Smart Campus Digital Twin & Analytics Platform - Backend Environment Variables

# MongoDB Atlas Connection String (Required)
# Replace the placeholders with your own database credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/unitwin?retryWrites=true&w=majority

# API Server Port
PORT=5001

# Google Gemini API Key for AI Floating Assistant (Optional)
# Keep the actual key in backend/.env, never commit it to Git.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Configurable Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# Solar Simulation Configuration (Demonstration Assumptions)
# Actual campus solar panel specifications have not been verified.
SOLAR_SIM_PANEL_COUNT=10
SOLAR_SIM_PANEL_RATING_WATTS=400
SOLAR_SIM_SYSTEM_LOSS_FACTOR=0.14
SOLAR_SIM_TIMEZONE=Asia/Kolkata