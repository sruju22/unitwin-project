# Unitwin Smart Campus Digital Twin & Analytics Platform - Backend Environment Variables

# MongoDB Atlas Connection String (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/unitwin?retryWrites=true&w=majority

# API Server Port (Default: 5001)
PORT=5001

# Google Gemini API Key for AI Floating Assistant (Optional but recommended)
# When configured, Unitwin AI leverages Google Gemini 2.5 Flash for natural language synthesis
# grounded in MongoDB campus telemetry.
# If omitted or unconfigured, the assistant operates with deterministic database grounding.
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Configurable Gemini Model Name (Default: gemini-3.8-flash)
# Supported options include: gemini-3.8-flash, gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-3.8-flash

# Solar Simulation Configuration (Demonstration Assumptions)
# Note: Physical campus solar panel specifications (wattage, installed capacity) are unverified.
# The platform employs a physics-based diurnal simulation model with the following configurable defaults:
SOLAR_SIM_PANEL_COUNT=10
SOLAR_SIM_PANEL_RATING_WATTS=400
SOLAR_SIM_SYSTEM_LOSS_FACTOR=0.14
SOLAR_SIM_TIMEZONE=Asia/Kolkata
